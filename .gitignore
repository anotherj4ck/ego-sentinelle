.claude/settings.local.json
__pycache__/
.pytest_cache/
*.pyc
.venv/
.coverage
htmlcov/
# Exports réels (comptes et IP réels) : jamais versionnés, sauf les données de test fictives.
*.csv
!tests/donnees/*.csv
# Rapports écrits par --sortie : ils recopient les comptes et les IP de l'export.
*.txt
!requirements*.txt
# Rapports écrits par --html : ils recopient les comptes et les IP de l'export.
*.html
!docs/maquette/*.html
# Journaux Windows exportés depuis l'Observateur d'événements.
*.evtx
